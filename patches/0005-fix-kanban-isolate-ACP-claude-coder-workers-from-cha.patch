From b2e27e190264bd31d83d94b207b63380e7c6c1b8 Mon Sep 17 00:00:00 2001
From: Hermes Coder <coder@hermes.local>
Date: Wed, 8 Jul 2026 12:02:43 +1000
Subject: [PATCH] fix(kanban): isolate ACP claude-coder workers from chat
 session credentials

Kanban claude-coder workers and the Hermes chat session's `claude` CLI
both read/write ~/.claude/.credentials.json. A concurrent token refresh
between the two zeroed out both tokens (2026-07-07 incident). Point
kanban's claude/claude-code spawns at CLAUDE_CONFIG_DIR=~/.claude-kanban
instead, so worker auth is isolated from the chat session's.
---
 hermes_cli/kanban_db.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index aa92287a8..bb835dac4 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -6526,6 +6526,10 @@ def _default_spawn(
         if _basename in ("claude", "claude-code"):
             if "-p" not in cmd and "--print" not in cmd:
                 cmd.append("-p")
+            # Isolate kanban claude-coder workers from the chat session's
+            # ~/.claude/.credentials.json — a concurrent token refresh
+            # between the two zeroed out both tokens (2026-07-07 incident).
+            env.setdefault("CLAUDE_CONFIG_DIR", os.path.expanduser("~/.claude-kanban"))
         cmd.append(acp_prompt)
         # Use 'a' so a re-run on unblock appends rather than overwrites.
         log_f = open(log_path, "ab")

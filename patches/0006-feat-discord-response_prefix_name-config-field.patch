From 446a46f909a2e95b91094310c9d5b232679f714b Mon Sep 17 00:00:00 2001
From: Hermes Coder <coder@hermes.local>
Date: Tue, 4 Aug 2026 22:06:48 +1000
Subject: [PATCH] feat(discord): source response_prefix name from config
 instead of hardcoded "Hermes"
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adds discord.response_prefix_name config field, bridged through
gateway/config.py into DiscordAdapter.extra, so profiles like Niro
can set their own display name in the [{name} · {model}] reply
prefix instead of always showing "Hermes".
---
 gateway/config.py                    | 2 ++
 plugins/platforms/discord/adapter.py | 2 +-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/gateway/config.py b/gateway/config.py
index f05a1c1388..9f0998348e 100644
--- a/gateway/config.py
+++ b/gateway/config.py
@@ -1546,6 +1546,8 @@ def load_gateway_config() -> GatewayConfig:
                     bridged["reply_prefix"] = platform_cfg["reply_prefix"]
                 if "response_prefix" in platform_cfg:
                     bridged["response_prefix"] = platform_cfg["response_prefix"]
+                if "response_prefix_name" in platform_cfg:
+                    bridged["response_prefix_name"] = platform_cfg["response_prefix_name"]
                 if "reply_in_thread" in platform_cfg:
                     bridged["reply_in_thread"] = platform_cfg["reply_in_thread"]
                 if "cron_continuable_surface" in platform_cfg:
diff --git a/plugins/platforms/discord/adapter.py b/plugins/platforms/discord/adapter.py
index 245abe07c7..850078dbf6 100644
--- a/plugins/platforms/discord/adapter.py
+++ b/plugins/platforms/discord/adapter.py
@@ -1068,7 +1068,7 @@ class DiscordAdapter(BasePlatformAdapter):
         # updates this per-reply after each agent run.
         _init_model = os.getenv("HERMES_MODEL", "") or self.config.extra.get("model", "")
         self._response_prefix_context: Dict[str, str] = {
-            "name": "Hermes",
+            "name": self.config.extra.get("response_prefix_name") or "Hermes",
             "model_full": _init_model,
         }
 
